# Local development only. Production must use cloudflare-access.
DEVSPACE_AUTH_MODE=development
DEVSPACE_APP_ORIGIN=http://localhost:3000
DEVSPACE_DATABASE_PATH=.devspace-local/devspace.sqlite
DEVSPACE_AGENT_SOCKET_PATH=.devspace-local/agent.sock

# Production authentication (never commit real values):
# DEVSPACE_AUTH_MODE=cloudflare-access
# DEVSPACE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# DEVSPACE_ACCESS_AUDIENCE=your-access-application-audience
