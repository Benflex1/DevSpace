NODE_ENV=production
DEVSPACE_WEB_HOST=127.0.0.1
PORT=3000
DEVSPACE_APP_ORIGIN=https://devspace.example.com
DEVSPACE_DATABASE_PATH=/var/lib/devspace-web/devspace.sqlite
DEVSPACE_AGENT_SOCKET_PATH=/run/devspace-agent/agent.sock
DEVSPACE_AUTH_MODE=cloudflare-access
DEVSPACE_ACCESS_ISSUER=https://team-name.cloudflareaccess.com
DEVSPACE_ACCESS_AUDIENCE=replace-with-access-application-aud-tag
DEVSPACE_PREVIEW_BASES='[]'

# If previews are configured, keep this value identical to agent.env.
# DEVSPACE_PREVIEW_BASES='[{"id":"main","domain":"preview.example.com","labelSuffix":"-preview"}]'
