NODE_ENV=production
DEVSPACE_AGENT_SOCKET_PATH=/run/devspace-agent/agent.sock
DEVSPACE_MANAGED_ROOT=/var/lib/devspace-agent/managed
DEVSPACE_DOCKER_SOCKET_PATH=/run/user/@AGENT_UID@/docker.sock
DEVSPACE_PREVIEW_BASES='[]'

# Optional: set these only after deploying the Preview Gateway from the existing
# contract in docs/preview-gateway-deployment.md. Use the same preview bases in
# this file and web.env, and point these sockets at the deployed gateway host.
# DEVSPACE_PREVIEW_BASES='[{"id":"main","domain":"preview.example.com","labelSuffix":"-preview"}]'
# DEVSPACE_CADDY_ADMIN_SOCKET=/srv/devspace/gateway/caddy-admin.sock
# DEVSPACE_PREVIEW_PROBE_SOCKET=/srv/devspace/gateway/preview-probe.sock
# DEVSPACE_PREVIEW_LEASE_RESOLVER_SOCKET=/srv/devspace/gateway/lease-resolver.sock
