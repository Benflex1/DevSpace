{
  "extends": "../../tsconfig.typecheck.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {},
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "plugins": [{ "name": "next" }],
    "tsBuildInfoFile": "../../.cache/tsbuild/apps-web.typecheck.tsbuildinfo"
  },
  "include": ["next-env.d.ts", "next.config.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
