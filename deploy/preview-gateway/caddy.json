{
  "admin": {
    "listen": "unix//run/devspace/gateway/caddy-admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "devspace-preview": {
          "listen": [
            "127.0.0.1:18080",
            "unix//run/devspace/gateway/ingress/preview-http.sock|0660"
          ],
          "automatic_https": {
            "disable": true
          },
          "routes": [
            {
              "@id": "devspace-preview-fallback-v1",
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "Not Found"
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
