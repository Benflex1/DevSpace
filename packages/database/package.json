{
  "name": "@devspace/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "pnpm --dir ../.. --filter @devspace/domain run build && node scripts/generate-migration.mjs",
    "db:check": "pnpm --dir ../.. --filter @devspace/domain run build && node scripts/check-migrations.mjs",
    "db:migrate:test": "pnpm --dir ../.. exec vitest run --project @devspace/database",
    "typecheck": "tsc --project tsconfig.json --pretty false && tsc --project tsconfig.test.json --pretty false",
    "build": "tsc --build tsconfig.build.json --force --pretty false && node scripts/copy-migrations.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@devspace/domain": "workspace:*",
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@devspace/testkit": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "drizzle-kit": "0.31.10"
  }
}
