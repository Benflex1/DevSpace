{
  "schemaVersion": 1,
  "namedVolumes": [
    {
      "key": "pnpm-store",
      "kind": "cache"
    },
    {
      "key": "postgres-data",
      "kind": "data"
    }
  ],
  "developmentEnvironment": {
    "source": {
      "kind": "dockerfile",
      "dockerfilePath": "Dockerfile",
      "contextPath": "."
    },
    "containerUser": "devspace",
    "passwordlessSudo": true,
    "workingDirectory": "/workspace",
    "environment": {
      "NODE_ENV": {
        "kind": "literal",
        "value": "development"
      },
      "CI_TOKEN": {
        "kind": "host",
        "variable": "CI_TOKEN"
      },
      "API_KEY": {
        "kind": "secret",
        "secretId": "018f0f00-0000-7000-8000-000000000001"
      }
    },
    "ports": [
      {
        "name": "web",
        "containerPort": 3000,
        "protocol": "tcp"
      }
    ],
    "volumes": [
      {
        "volumeKey": "pnpm-store",
        "mountPath": "/home/devspace/.local/share/pnpm/store"
      }
    ],
    "setupSteps": [
      {
        "executable": "pnpm",
        "args": [
          "install",
          "--frozen-lockfile"
        ],
        "workingDirectory": ".",
        "environment": {}
      }
    ],
    "rebuildPolicy": "on-revision-change"
  },
  "tasks": [
    {
      "key": "test",
      "displayName": "Run tests",
      "command": {
        "executable": "pnpm",
        "args": [
          "test"
        ],
        "workingDirectory": ".",
        "environment": {}
      },
      "interactive": false,
      "longRunning": false,
      "timeoutSeconds": 900,
      "concurrencyPolicy": "reject",
      "successExitCodes": [
        0
      ],
      "logRetentionDays": null
    }
  ],
  "services": [
    {
      "key": "postgres",
      "imageReference": "postgres:16",
      "environment": {},
      "volumes": [
        {
          "volumeKey": "postgres-data",
          "mountPath": "/var/lib/postgresql/data"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "containerPort": 5432,
          "protocol": "tcp"
        }
      ],
      "entrypoint": null,
      "command": [
        "postgres"
      ],
      "workingDirectory": null,
      "healthCheck": {
        "kind": "tcp",
        "portName": "postgres"
      },
      "dependsOn": [],
      "resources": {
        "cpuMillicores": 500,
        "memoryBytes": 536870912
      }
    }
  ],
  "previews": [
    {
      "key": "web",
      "displayName": "Web preview",
      "target": {
        "kind": "workspace"
      },
      "containerPort": 3000,
      "domainBaseId": "preview-main",
      "hostnamePattern": "{project}-{workspace}-{preview}-{shortId}",
      "protocol": "http",
      "healthPath": "/",
      "healthStatuses": [
        200
      ],
      "startupTimeoutSeconds": 60,
      "webSocketForwarding": true
    },
    {
      "key": "database",
      "displayName": "Database preview",
      "target": {
        "kind": "service",
        "serviceKey": "postgres"
      },
      "containerPort": 5432,
      "domainBaseId": "preview-main",
      "hostnamePattern": "{project}-{preview}",
      "protocol": "http",
      "healthPath": "/health",
      "healthStatuses": [
        200
      ],
      "startupTimeoutSeconds": 90,
      "webSocketForwarding": false
    }
  ],
  "aiProfile": {
    "providerKey": "openai",
    "executableProfileKey": "codex-cli",
    "fixedArgs": [
      "--project-dir",
      "."
    ],
    "credentialSecretIds": [
      "018f0f00-0000-7000-8000-000000000001"
    ],
    "instructionsFilePath": "AGENTS.md",
    "networkDisclosureAcknowledged": true
  },
  "resources": {
    "cpuMillicores": 4000,
    "memoryBytes": 8589934592,
    "pidLimit": 2048,
    "maxNamedVolumeBytes": 10737418240,
    "logRetentionDays": 30,
    "stoppedWorkspaceRetentionDays": 14,
    "automaticStopMinutes": 120,
    "maxConcurrentWorkspaces": 3
  }
}
