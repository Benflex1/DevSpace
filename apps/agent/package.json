{
  "name": "@devspace/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:helper && pnpm --dir ../.. exec tsx apps/agent/src/cli.ts",
    "start": "node dist/cli.js",
    "codex:bootstrap": "pnpm run build && node dist/codex-bootstrap-cli.js",
    "test": "pnpm --dir ../.. exec vitest run --project @devspace/agent",
    "verify:runtime:real": "pnpm --dir ../.. exec tsx apps/agent/test/verify-real-rootless.ts",
    "verify:codex:split:pty": "pnpm --dir ../.. exec tsx apps/agent/test/verify-codex-cli-split-pty.ts",
    "verify:codex:split:preflight": "pnpm --dir ../.. exec tsx apps/agent/test/verify-codex-cli-split-preflight.ts",
    "verify:codex:split:real": "pnpm --dir ../.. exec tsx apps/agent/test/verify-codex-cli-split-execution.ts",
    "typecheck": "tsc --project tsconfig.json --pretty false && tsc --project tsconfig.test.json --pretty false",
    "build:helper": "node ../../tooling/build-staged-readback-helper.mjs && node ../../tooling/build-github-askpass-helper.mjs",
    "build": "pnpm run build:helper && tsc --build tsconfig.build.json --force --pretty false"
  },
  "dependencies": {
    "@devspace/contracts": "workspace:*",
    "@devspace/diagnostics": "workspace:*",
    "@devspace/domain": "workspace:*",
    "@devspace/gateway-caddy": "workspace:*",
    "@devspace/project-options": "workspace:*",
    "@devspace/security": "workspace:*",
    "uuid": "14.0.1",
    "ws": "8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
